+/* On error the caller unmaps the reserved range from the same page table. */
+int moat_vmap_page_array(struct moat_mem *mem, pgprot_t prot, pgd_t *pgd)
+{
+	unsigned long addr = (unsigned long)mem->addr;
+	unsigned long i;
+	int ret;
+
+	for (i = 0; i < mem->nr_pages; i++, addr += PAGE_SIZE) {
+		ret = moat_vmap_range(addr, addr + PAGE_SIZE,
+				      page_to_phys(mem->page_array[i]), prot, pgd);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
